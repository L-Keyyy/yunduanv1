{
  "name": "ai-product-page-generator",
  "version": "0.1.0",
  "private": false,
  "description": "AI e-commerce detail page generation and editing workspace",
  "author": "MatrixInspire Inc",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node ./scripts/run-next-safe.cjs dev",
    "build": "npm run prisma:generate && node ./scripts/run-next-safe.cjs build",
    "start": "node ./scripts/run-next-safe.cjs start",
    "test:pet-toy-batch": "node --test ./scripts/lib/pet-toy-batch.test.mjs",
    "test:extension-ai-follow": "node --test ./scripts/lib/extension-ai-follow.test.mjs",
    "test:processing-fifo": "node --test ./scripts/lib/processing-fifo.test.mjs",
    "test:ozon-price-floor": "node --test ./scripts/lib/ozon-price-floor.test.mjs",
    "listing:pet-toy-batch": "node ./scripts/run-pet-toy-listing-batch.mjs",
    "listing:collect-pet-toys": "node ./scripts/collect-1688-pet-toys.mjs",
    "listing:repair-pet-toy-cards": "node ./scripts/repair-1688-pet-toy-cards.mjs",
    "listing:repair-pet-toy-images": "node --env-file=.env ./scripts/repair-ozon-pet-toy-images.mjs",
    "listing:regenerate-translate-upload": "node --env-file=.env ./scripts/regenerate-translate-upload-pet-toys.mjs",
    "desktop:start": "node ./scripts/build-desktop.cjs start",
    "ozon:sync-all-attributes": "node --env-file=.env ./scripts/sync-all-ozon-attributes.mjs --refresh-tree --delay-ms=150",
    "ozon:sync-all-translations": "node --env-file=.env ./scripts/sync-all-ozon-translations.mjs --batch-size=20 --delay-ms=120",
    "ozon:audit-all-stores": "node --env-file=.env ./scripts/audit-all-ozon-stores.mjs ./storage/ozon-store-audit.json",
    "ozon:build-round-robin-plan": "python3 ../../scripts/build_ozon_round_robin_plan.py --limit 1200 --minimum-sales 0 --maximum-followers 1000000",
    "ozon:run-500-round-robin": "node --env-file=.env ./scripts/run-ozon-round-robin-copy.mjs --target 500 --batch-size 10 --offer-prefix RR500- --state storage/ozon-500-round-robin-state.json --plan storage/ozon-500-round-robin-plan.json --stock 100",
    "ozon:repair-round-robin-images": "node --env-file=.env ./scripts/repair-ozon-round-robin-images.mjs",
    "ozon:archive-failed-round-robin-cards": "node --env-file=.env ./scripts/archive-ozon-round-robin-failed-cards.mjs",
    "ozon:set-round-robin-stock-100": "node --env-file=.env ./scripts/set-ozon-round-robin-stocks.mjs 100",
    "ozon:dedupe-round-robin-globally": "node --env-file=.env ./scripts/dedupe-ozon-round-robin-globally.mjs",
    "ozon:set-global-kept-prices-4x": "node --env-file=.env ./scripts/set-ozon-global-kept-prices-4x.mjs",
    "ozon:repair-rr4x-price-floor": "node --env-file=.env ./scripts/repair-ozon-rr4x-price-floor.mjs",
    "ozon:retry-rr4x-failed-imports": "node --env-file=.env ./scripts/retry-ozon-rr4x-failed-imports.mjs",
    "listing:repair-price-floor": "node --env-file=.env ./scripts/repair-listing-workflow-price-floor.mjs",
    "ozon:regenerate-rr4x-images": "node --env-file=.env ./scripts/regenerate-rr4x-main-images.mjs",
    "ozon:run-daily-unique-4x": "node --env-file=.env ./scripts/regenerate-rr4x-main-images.mjs",
    "build:desktop": "node ./scripts/build-desktop.cjs prepare",
    "dist:win": "npm run build:desktop && .\\node_modules\\.bin\\electron-builder.cmd --win nsis",
    "dist:green": "npm run build:desktop && .\\node_modules\\.bin\\electron-builder.cmd --win dir zip",
    "dist:all-win": "npm run build:desktop && .\\node_modules\\.bin\\electron-builder.cmd --win nsis dir zip",
    "lint": "node -e \"console.log('Linting is not configured for this Windows path-safe build.')\"",
    "prisma:generate": "node ./scripts/run-prisma-safe.cjs generate",
    "prisma:migrate": "node ./scripts/apply-prisma-migrations.cjs",
    "prisma:deploy": "node ./scripts/apply-prisma-migrations.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonrepair": "^3.14.1",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "electron": "^35.2.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.matrixinspire.bananamall",
    "productName": "AI Product Page Generator",
    "asar": false,
    "asarUnpack": [
      ".next/standalone/node_modules/.prisma/**/*",
      ".next/standalone/node_modules/@prisma/**/*"
    ],
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "scripts/runtime-paths.cjs",
      "scripts/apply-prisma-migrations.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ai-product-page-generator-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
