DATABASE_URL="file:./dev.db"
OZON_API_BASE_URL="https://api-seller.ozon.ru"
OZON_CLIENT_ID=""
OZON_API_KEY=""
OZON_HD_CACHE_DIR=""
APP_SECRET="replace-with-your-own-long-secret"
STORAGE_ROOT="./storage"
APP_RUNTIME="web"
# APP_USER_DATA_DIR=""
NEXT_PUBLIC_APP_NAME="banana-mall"
LISTING_IMAGE_GITHUB_REPO=""
LISTING_IMAGE_GITHUB_BRANCH="main"
LISTING_IMAGE_PUBLIC_BASE_URL=""
# 扩展勾选“AI模型处理图片”时使用；本地工作台保存的模型选择优先。
LISTING_IMAGE_PROVIDER_ID="browser-webai"
LISTING_IMAGE_MODEL_ID="doubao-image-web"
LISTING_IMAGE_QUOTA_FALLBACK_MODEL="gpt-image-1.5"
# 固定坐标去标记可能覆盖商品标题；仅在确认模型输出位置后显式开启。
REMOVE_AI_WATERMARKS_ENABLED="0"

# 如果直连 Google/Gemini 超时，填本机代理地址并重启 web。
# macOS 常见 Clash 端口示例：
# HTTPS_PROXY="http://127.0.0.1:7890"
# HTTP_PROXY="http://127.0.0.1:7890"
# ALL_PROXY="socks5://127.0.0.1:7890"
# NO_PROXY="localhost,127.0.0.1"
