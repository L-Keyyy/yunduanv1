APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
AUTO_CREATE_SCHEMA=false
ENABLE_LOCAL_BOOTSTRAP=false

OZON_CLIENT_ID=
OZON_API_KEY=

DATABASE_URL=postgresql+psycopg2://ozon_user:change_me@your-rds-endpoint:5432/ozon
REDIS_URL=redis://your-redis-endpoint:6379/0
CELERY_BROKER_URL=redis://your-redis-endpoint:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-endpoint:6379/0

SECRET_KEY=change-me-to-a-long-random-value
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-value-or-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

CORS_ORIGINS=https://app.example.com,http://localhost:3000
CHROME_DEVTOOLS_BASE=http://127.0.0.1:9222
RUN_MIGRATIONS_ON_START=1
