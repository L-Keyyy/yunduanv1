[Unit]
Description=Ozon Celery Worker - Upload Queue
After=network-online.target
Wants=network-online.target

[Service]
User=ozon
WorkingDirectory=/opt/ozon/backend
EnvironmentFile=/opt/ozon/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=CELERY_WORKER_NAME=upload
Environment=CELERY_QUEUES=upload
Environment=CELERY_CONCURRENCY=1
ExecStart=/bin/sh /opt/ozon/backend/start-worker.sh
Restart=always
RestartSec=5
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
