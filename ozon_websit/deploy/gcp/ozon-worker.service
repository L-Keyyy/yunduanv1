[Unit]
Description=Ozon Celery Worker - Sync Queue
After=network-online.target
Wants=network-online.target

[Service]
User=ozon
WorkingDirectory=/opt/ozon/backend
EnvironmentFile=/opt/ozon/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=CELERY_WORKER_NAME=sync
Environment=CELERY_QUEUES=default,sync
Environment=CELERY_CONCURRENCY=1
ExecStart=/bin/sh /opt/ozon/backend/start-worker.sh
Restart=always
RestartSec=5
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
