APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
AUTO_CREATE_SCHEMA=false
ENABLE_LOCAL_BOOTSTRAP=false

DATABASE_URL=postgresql+psycopg2://ozon_user:change_me@127.0.0.1:5432/ozon
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

SECRET_KEY=change-me-to-a-long-random-value
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-value-or-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

OZON_CLIENT_ID=
OZON_API_KEY=

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://YOUR_GCP_EXTERNAL_IP
ENABLE_BROWSER_ASSIST_HEALTH=false
CHROME_DEVTOOLS_BASE=http://127.0.0.1:9222
RUN_MIGRATIONS_ON_START=1
CELERY_LOGLEVEL=info
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=393216
UPLOAD_MAX_ACTIVE_STORES_PER_TENANT=1
UPLOAD_MAX_ACTIVE_STORES_PER_TENANT_HARD_CAP=1
UPLOAD_MAX_GLOBAL_ACTIVE_STORES=1
UPLOAD_MAX_GLOBAL_ACTIVE_STORES_HARD_CAP=1
UPLOAD_MAX_ITEMS_PER_JOB=20
UPLOAD_MAX_ITEMS_PER_JOB_HARD_CAP=20
UPLOAD_MAX_ATTEMPTS=3
UPLOAD_TIMEOUT_SECONDS=900
UPLOAD_RESULT_POLL_INTERVAL_SECONDS=300
UPLOAD_RESULT_POLL_INTERVAL_MIN_SECONDS=300
UPLOAD_RESULT_POLL_LIMIT=10
MANUAL_ORDER_SYNC_LIMIT=3
MANUAL_ORDER_SYNC_WINDOW_SECONDS=1800
MANUAL_SYNC_LIMIT=3
MANUAL_SYNC_WINDOW_SECONDS=1800
ORDER_SYNC_INTERVAL_MINUTES=120
SELLER_ANALYTICS_CACHE_TTL_SECONDS=259200
