[Unit]
Description=Ozon Backend API
After=network.target

[Service]
User=ozon
WorkingDirectory=/opt/ozon/backend
EnvironmentFile=/opt/ozon/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh /opt/ozon/backend/start-api.sh
Restart=always
RestartSec=5
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
