[Unit]
Description=Ozon Celery Beat Scheduler
After=network-online.target
Wants=network-online.target

[Service]
User=ozon
WorkingDirectory=/opt/ozon/backend
EnvironmentFile=/opt/ozon/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh /opt/ozon/backend/start-beat.sh
Restart=always
RestartSec=5
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
