[Unit]
Description=Ozon Celery Worker - Browser Queue
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/ozon_backend
EnvironmentFile=/home/ec2-user/ozon_backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=CELERY_WORKER_NAME=browser
Environment=CELERY_QUEUES=browser
Environment=CELERY_CONCURRENCY=1
ExecStart=/bin/sh /home/ec2-user/ozon_backend/start-worker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
