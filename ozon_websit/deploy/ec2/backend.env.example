APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
AUTO_CREATE_SCHEMA=false
ENABLE_LOCAL_BOOTSTRAP=false

DATABASE_URL=postgresql+psycopg2://ozon_user:change_me@your-rds-endpoint:5432/ozon
REDIS_URL=redis://your-redis-endpoint:6379/0
CELERY_BROKER_URL=redis://your-redis-endpoint:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-endpoint:6379/0

SECRET_KEY=change-me-to-a-long-random-value
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-value-or-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

OZON_CLIENT_ID=
OZON_API_KEY=

CORS_ORIGINS=http://localhost,http://127.0.0.1
CHROME_DEVTOOLS_BASE=http://127.0.0.1:9222
RUN_MIGRATIONS_ON_START=1
CELERY_LOGLEVEL=info
UPLOAD_MAX_ACTIVE_STORES_PER_TENANT=2
UPLOAD_MAX_GLOBAL_ACTIVE_STORES=48
UPLOAD_MAX_ATTEMPTS=3
UPLOAD_TIMEOUT_SECONDS=900
UPLOAD_RESULT_POLL_INTERVAL_SECONDS=90
MANUAL_ORDER_SYNC_LIMIT=5
MANUAL_ORDER_SYNC_WINDOW_SECONDS=1800
ORDER_SYNC_INTERVAL_MINUTES=120
SELLER_ANALYTICS_CACHE_TTL_SECONDS=259200
