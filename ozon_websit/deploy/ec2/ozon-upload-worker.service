[Unit]
Description=Ozon Celery Worker - Upload Queue
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/ozon_backend
EnvironmentFile=/home/ec2-user/ozon_backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=CELERY_WORKER_NAME=upload
Environment=CELERY_QUEUES=upload
Environment=CELERY_CONCURRENCY=3
ExecStart=/bin/sh /home/ec2-user/ozon_backend/start-worker.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
