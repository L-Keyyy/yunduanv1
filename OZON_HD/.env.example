# OZON SaaS 环境变量
# 复制此文件为 .env 并修改

# 服务端口
PORT=3000

# JWT 密钥（生产环境必须修改）
JWT_SECRET=your-jwt-secret-here-change-me

# 加密密钥（用于加密 OZON API Key，生产环境必须修改）
ENCRYPTION_KEY=your-encryption-key-here-change-me

# Redis 连接（Docker 环境自动设置）
# REDIS_URL=redis://localhost:6379

# 数据库路径（Docker 环境自动设置）
# DB_PATH=./server/data/ozon_saas.db

# CORS 允许域名（* 表示全部）
CORS_ORIGIN=*
